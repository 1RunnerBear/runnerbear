{
  "name": "runnerbear-cloud",
  "private": true,
  "version": "9.8.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "wrangler check",
    "deploy": "wrangler deploy -y",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:smoke:remote": "wrangler d1 execute DB --remote --command=\"SELECT name FROM sqlite_master WHERE type='table' AND name='rb_users'\" --json"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}
