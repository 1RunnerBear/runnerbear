{
  "name": "runnerbear-cloud",
  "private": true,
  "version": "10.22.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "wrangler check",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:smoke:remote": "wrangler d1 execute DB --remote --command=\"SELECT name FROM sqlite_master WHERE type='table' AND name='rb_users'\" --json",
    "access:configure": "node scripts/configure-access.mjs"
  },
  "dependencies": {
    "jose": "6.2.3"
  },
  "devDependencies": {
    "wrangler": "^4.120.1"
  }
}
