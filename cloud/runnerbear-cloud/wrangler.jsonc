{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "src/index-v1027.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "PRIMARY_USER_ID": "primary",
    "PRIMARY_USER_EMAIL": "torbjorn.forre@gmail.com",
    "CORS_ORIGINS": "",
    "COACH_LOOP_KILL_SWITCH": "false"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "services": [
    {
      "binding": "TREDICT",
      "service": "runnerbear-tredict-bridge",
      "entrypoint": "TredictService"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ]
}
