{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "src/index-v1141.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "PRIMARY_USER_ID": "primary",
    "PRIMARY_USER_EMAIL": "torbjorn.forre@gmail.com",
    "CORS_ORIGINS": "",
    "COACH_LOOP_KILL_SWITCH": "false",
    "COACH_LIVE_MODEL": "@cf/zai-org/glm-4.7-flash",
    "COACH_LIVE_RELEASE": "11.4.1-owner-20260830",
    "ONE_DECISION_RELEASE": "11.4.1-owner-20260830",
    "COACH_CONTINUITY_RELEASE": "11.4.1-owner-20260830",
    "BAKKEN_ENGINE_RELEASE": "11.0.0-owner-20260824",
    "GOAL_REPAIR_RELEASE": "10.31.2-owner-20260824",
    "GOAL_REPAIR_ID": "bergen-half-2026",
    "GOAL_REPAIR_NAME": "Bergen Maraton",
    "GOAL_REPAIR_DATE": "2026-10-12",
    "GOAL_REPAIR_DISTANCE": "half",
    "GOAL_REPAIR_TARGET_SECONDS": "4980",
    "GOAL_REPAIR_B_ID": "haugesund-half-2026",
    "GOAL_REPAIR_B_NAME": "Haugesund halvmaraton",
    "GOAL_REPAIR_B_DATE": "2026-09-14",
    "GOAL_REPAIR_B_DISTANCE": "half",
    "GOAL_REPAIR_B_EFFORT": "race"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "services": [
    {
      "binding": "TREDICT",
      "service": "runnerbear-tredict-bridge",
      "entrypoint": "TredictService"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ]
}
